# ===================================================================
# Sekar Fitness Equipments - Environment Configuration
# ===================================================================

# Firebase Web Client Configuration (Vercel / Next.js / Vite)
# Note: For Vite projects, variables are prefixed with VITE_.
# For Next.js projects on Vercel, NEXT_PUBLIC_ is also supported.

VITE_FIREBASE_API_KEY="AIzaSyYourFirebaseApiKeyHere"
VITE_FIREBASE_AUTH_DOMAIN="sekar-fitness.firebaseapp.com"
VITE_FIREBASE_PROJECT_ID="sekar-fitness"
VITE_FIREBASE_STORAGE_BUCKET="sekar-fitness.appspot.com"
VITE_FIREBASE_MESSAGING_SENDER_ID="123456789012"
VITE_FIREBASE_APP_ID="1:123456789012:web:abcdef1234567890"

# Optional Next.js equivalents for Vercel deployment
NEXT_PUBLIC_FIREBASE_API_KEY="AIzaSyYourFirebaseApiKeyHere"
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN="sekar-fitness.firebaseapp.com"
NEXT_PUBLIC_FIREBASE_PROJECT_ID="sekar-fitness"
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET="sekar-fitness.appspot.com"
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID="123456789012"
NEXT_PUBLIC_FIREBASE_APP_ID="1:123456789012:web:abcdef1234567890"

# WhatsApp Business / Factory Dispatch Hotline (Chennai)
VITE_WHATSAPP_NUMBER="916381914335"

# GEMINI_API_KEY: Injected by AI Studio if used
GEMINI_API_KEY="MY_GEMINI_API_KEY"
APP_URL="MY_APP_URL"
