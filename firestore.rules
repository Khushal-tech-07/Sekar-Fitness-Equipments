rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // User profile documents
    match /users/{userId} {
      allow get: if isOwner(userId);
      allow create, update: if isOwner(userId) && isValidId(userId);
      allow delete: if isOwner(userId);
    }

    // Equipment quotation enquiries
    match /enquiries/{enquiryId} {
      allow create: if isValidId(enquiryId) && 
        request.resource.data.id is string && 
        request.resource.data.id.size() <= 64 &&
        request.resource.data.customerName is string &&
        request.resource.data.customerName.size() <= 128;
      
      allow get: if isSignedIn() && (
        resource.data.userId == request.auth.uid || 
        resource.data.userEmail == request.auth.token.email
      );

      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;

      allow delete: if isSignedIn() && resource.data.userId == request.auth.uid;
    }

    // Connection test document
    match /test/connection {
      allow read: if true;
    }
  }
}
